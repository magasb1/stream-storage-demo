<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      The desktop client is net10.0-windows, so without this the solution does not restore on
      Linux at all and `dotnet test` fails before it has discovered a test. That failure is easy
      to mistake for a pass: it happens during restore, prints nothing resembling a test result,
      and a piped command reports the exit status of whatever it was piped into. The client still
      only runs on Windows - this is what lets the other five projects be built and tested from
      the two platforms the README claims.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
