# The test image, because the SRT tests need libsrt and an FFmpeg with SRT, and Windows can supply
# neither without a C++ toolchain.
#   docker build -f docker/Dockerfile.test -t storagedemo-tests .
#   docker run --rm storagedemo-tests
#
# Arguments to `docker run` are passed on to `dotnet test`, so a single class is
#   docker run --rm storagedemo-tests --filter FullyQualifiedName~SrtListenerTests
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

# Same two halves as the runtime image: the hardware-acceleration libraries the fetched FFmpeg links
# at load time, and the distro libsrt, which is what Srt.cs finds by soname once it has looked
# beside the libav libraries and found nothing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libx11-6 libdrm2 libva2 libva-drm2 libvdpau1 libvpl2 \
        libsrt1.5-openssl \
        curl xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG FFMPEG_BUILD=ffmpeg-n8.1-latest-linux64-gpl-shared-8.1
RUN curl -fsSL -o /tmp/ffmpeg.tar.xz \
        "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/${FFMPEG_BUILD}.tar.xz" \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp \
    && mv /tmp/${FFMPEG_BUILD} /opt/ffmpeg \
    && rm /tmp/ffmpeg.tar.xz

COPY . .
RUN dotnet build tests/StorageDemo.Tests/StorageDemo.Tests.csproj -c Release

# The LGPL package's libraries land in the test output; the SRT-capable build replaces them there,
# which is the same substitution scripts/fetch-ffmpeg.sh makes for a local run.
ENV FFMPEG_DIR=/src/tests/StorageDemo.Tests/bin/Release/net10.0/ffmpeg/linux-x64
RUN cp -P /opt/ffmpeg/lib/*.so* "$FFMPEG_DIR/" \
    && cp /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe "$FFMPEG_DIR/" \
    && chmod +x "$FFMPEG_DIR/ffmpeg" "$FFMPEG_DIR/ffprobe"

# libav is loaded by explicit path and its libraries then resolve each other through the normal
# loader, which does not look next to the library it just loaded.
ENV LD_LIBRARY_PATH=/src/tests/StorageDemo.Tests/bin/Release/net10.0/ffmpeg/linux-x64

ENTRYPOINT ["dotnet", "test", "tests/StorageDemo.Tests/StorageDemo.Tests.csproj", "-c", "Release", "--no-build"]
