      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "storage-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (socket) (rate(live_viewer_dropped{service_instance_id=~\"$replica\"}[$__rate_interval]))",
          "legendFormat": "{{socket}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Viewers this pod dropped for accepting no bytes at all while their connection stayed up. Zero is the normal reading: an ordinary slow viewer never appears here, because libsrt discards from the send buffer for any peer that advertised too-late-packet drop, and what such a viewer loses is picture rather than its connection. What does appear is a peer that cleared that flag and stopped reading, which cannot be refused at the handshake because the flag is not readable from this end - this counter is the only sign of it. Each one held a pool thread and about eleven megabytes of send buffer for its whole budget before being dropped. The budget is derived per connection to clear libsrt's own drop threshold at the latency that connection negotiated, so Live:ViewerSendStallSeconds can raise it but not lower it into a working viewer: a sustained rate here is a fan-out of peers that are not reading."
    },
