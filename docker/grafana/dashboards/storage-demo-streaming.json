    {
      "id": 9,
      "type": "timeseries",
      "title": "Ingest bitrate",
      "datasource": {
        "type": "prometheus",
        "uid": "storage-demo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "storage-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service_instance_id) (rate(live_bytes{service_instance_id=~\"$replica\"}[$__rate_interval])) * 8",
          "legendFormat": "{{service_instance_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Bytes demultiplexed into a hub, as a rate. Counted by the hub while it holds the lock it already holds, and reported by the heartbeat, so nothing here costs the demultiplexer's thread an instrument call per packet."
    },
