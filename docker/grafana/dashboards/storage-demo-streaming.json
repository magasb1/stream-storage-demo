{
  "annotations": {
    "list": []
  },
  "description": "SRT ingest, the packet fan-out, capture and the heartbeat that keeps the cluster honest. Every series here is an aggregate: nothing is tagged with a stream name, because a thousand streams times several instruments is thousands of time series to answer a question GET /api/live answers per stream for free.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "This replica now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Streams owned",
      "datasource": {
        "type": "prometheus",
        "uid": "storage-demo-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "storage-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(live_streams_owned{service_instance_id=~\"$replica\"})",
          "legendFormat": "Streams owned",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "description": "Streams this replica holds the connection for, interrupted ones included. The same figure an autoscaler reads, and it is the one number here that cannot be trusted alone: see the kernel UDP errors below."
    },
