{
  "annotations": {
    "list": []
  },
  "description": "The two request surfaces, the documents that pass through them, the hop between replicas, and what the process costs. Mostly framework metrics: a gRPC call is an HTTP/2 request, so one histogram covers both surfaces.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 25,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "storage-demo-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "storage-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_count{service_instance_id=~\"$replica\"}[$__rate_interval]))",
          "legendFormat": "Requests/s",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "description": "Both surfaces. A gRPC call is an HTTP/2 request and is counted here too, with its method as the route."
    },
