bin/
obj/
data/
.vs/
*.user

# Local databases, uploaded files and logs never belong in the repository.
*.db
*.db-log

# Fetched by scripts/fetch-ffmpeg.sh, not committed: it is ~200 MB of binaries.
#
# No trailing slash, because a pattern with one matches directories only. A Linux developer, or a
# rig running in a worktree, points at one shared copy with a symlink rather than a second 200 MB
# of it - and a symlink named ffmpeg then showed up as untracked, one absolute path away from being
# committed into everybody else's checkout.
ffmpeg

# Other
scratch/
# Agent worktrees, created per isolated subagent run.
.claude/

# Test run artefacts, written by "dotnet test --logger trx".
TestResults/

# Fetched by scripts/fetch-rfdetr.sh, not committed: model weights (~470 MB) and the Python venv
# that exports them. The README documenting the tensor contract is kept.
models/*
!models/README.md
.venv/
