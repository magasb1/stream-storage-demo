<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- libav is called through pointers; there is no other way to talk to it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Each ORT provider package supplies a different native library with the same filename, so
         exactly one belongs in a publish. Override with
         -p:OnnxRuntimeFlavor=DirectML, Cuda, OpenVino, or Cpu. -->
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == '' and '$(OS)' == 'Windows_NT'">OpenVino</OnnxRuntimeFlavor>
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == ''">Cuda</OnnxRuntimeFlavor>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StorageDemo.Core\StorageDemo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103" />
    <!-- Ships ffmpeg/ffprobe and the libav libraries for every RID we run on. -->
    <PackageReference Include="DevEnvy.FFmpeg.Binaries.LGPL" Version="8.0.1.4" />
    <!-- Pinned to the FFmpeg 8.0 ABI that the binaries package ships. These move together. -->
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="8.0.0.1" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.0.0.1" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <!-- The in-cluster hop between two replicas is HTTP, and a relayed viewer holds one of these
         open for hours, so it wants the factory's handler pooling. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'OpenVino'">
    <PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Version="1.24.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="SeedData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateOnnxRuntimeFlavor" BeforeTargets="PrepareForBuild"
          Condition="'$(OnnxRuntimeFlavor)' != 'Cuda' and '$(OnnxRuntimeFlavor)' != 'OpenVino' and '$(OnnxRuntimeFlavor)' != 'DirectML' and '$(OnnxRuntimeFlavor)' != 'Cpu'">
    <Error Text="Unknown OnnxRuntimeFlavor '$(OnnxRuntimeFlavor)'. Use Cuda, OpenVino, DirectML, or Cpu." />
  </Target>

</Project>
