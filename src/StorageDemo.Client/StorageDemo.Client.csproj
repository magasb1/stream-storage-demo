<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF pins this to Windows; the API and its tests stay cross-platform. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!--
      And this is what lets the rest of the solution be built and tested from Linux, which the
      README's scenario B claims and its `dotnet test` requires: without it the whole solution
      fails to restore there with NETSDK1100, before a single test is discovered. That failure
      reads as a pass more easily than it should - it happens during restore, prints nothing
      resembling a test result, and a piped command reports the exit status of whatever it was
      piped into. The client is still Windows-only to run; this only builds it against the
      reference packs.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuses the shared content-type mapping only; the client holds no infrastructure. -->
    <ProjectReference Include="..\StorageDemo.Core\StorageDemo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FlyleafLib plays the video and Sdcb ships the libav libraries it loads, so the client
         never touches an FFmpeg installed on the machine.

         The pairing is not free choice: FlyleafLib 3.11.x binds the FFmpeg 9 ABI, which no NuGet
         package publishes natives for yet. 3.10.4 binds FFmpeg 7.1 (avcodec-61, avutil-59), which
         is exactly what this runtime package contains. Upgrade both together or neither. -->
    <PackageReference Include="FlyleafLib" Version="3.10.4" />
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Same contract file the server compiles, so the two can never drift. -->
    <Protobuf Include="..\..\protos\documents.proto" GrpcServices="Client" Link="Protos\documents.proto" />
  </ItemGroup>
</Project>
